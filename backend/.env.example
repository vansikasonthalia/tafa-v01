# Copy this file to .env and fill in your details

# Database Configuration (Optional for local development)
# If left blank, it will automatically use a local SQLite database (backend/data/tafa.db)
# For production, provide a Supabase/PostgreSQL connection string:
# DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-ID]:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres"

# Frontend Integration (Optional for local development)
# Only required for production deployments to allow Vercel to access the backend API
# FRONTEND_URL="https://tafa-screener.vercel.app"

# Telegram Bot Alerts
TELEGRAM_BOT_TOKEN="your_bot_token_here"
TELEGRAM_CHAT_ID="your_chat_id_here"
